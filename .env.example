# --- core -------------------------------------------------------------------
PORT=8790
# How your phone/browser reaches this server. Needed for tappable ntfy buttons.
PUBLIC_URL=http://192.168.0.3:8790
DB_PATH=./data/tether.db

# What the phone calls this server. Cosmetic until a server has several
# addresses -- then it is the thing that makes the settings screen say "NAS"
# instead of making an IP stand in for an identity.
SERVER_NAME=Tether

# Tokens are comma-separated. Generate with:  openssl rand -hex 24
# AGENT_TOKENS  -> may CREATE requests (Claude Code, other agents)
# CLIENT_TOKENS -> may READ and ANSWER them (phone, web UI)
# Keep the two sets disjoint: an agent must not answer its own question.
AGENT_TOKENS=replace-me-agent
CLIENT_TOKENS=replace-me-client

DEFAULT_TIMEOUT_SEC=3600
MAX_TIMEOUT_SEC=86400

# Zone that schedules are read in when the agent does not name one. The NAS runs
# UTC, so leaving this unset silently makes "07:00" mean 07:00 UTC.
DEFAULT_TIMEZONE=Africa/Gaborone

# --- voice (optional) -------------------------------------------------------
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_REFERENCE_ID=

# Silence prepended to every voice message, in milliseconds.
#
# Not cosmetic: an idle speaker takes a few hundred ms to wake and eats whatever
# plays meanwhile, so a message with no silent head is heard starting mid-word.
# The silence is what gets eaten instead of the first word. 0 disables it.
VOICE_LEAD_IN_MS=700

# Fish delivery. speed 0.5-2.0; slightly under 1 reads more clearly on a phone.
VOICE_SPEED=0.95
VOICE_TEMPERATURE=0.7
VOICE_TOP_P=0.7

# --- fan-out (optional) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# --- Android app push (FCM) ---------------------------------------------
# Service-account JSON for the Firebase project. This is a CREDENTIAL: keep it
# outside the repo. Without it the app cannot be reached while backgrounded.
# Mount the key read-only and point this at the container path. The compose
# file expects it at ./secrets/tether-fcm.json on the host.
FCM_CREDENTIALS=/run/secrets/tether-fcm.json
# How long a call rings before it is recorded as missed.
CALL_RING_SECONDS=45

# --- Live conversation -------------------------------------------------------
# How long the agent waits for you to say something before treating the turn as
# unanswered, and a hard ceiling on turns so a loop cannot run forever.
CALL_LISTEN_TIMEOUT_SEC=120
CALL_MAX_TURNS=40

# Speech to text. Pick one:
#
#   device   the phone transcribes and posts text. Nothing to configure, no
#            latency, no audio leaves the handset. Quality is the phone's.
#   whisper  a self-hosted Whisper on the LAN. Set STT_WHISPER_URL to an
#            OpenAI-compatible base, e.g. http://whisper:9000/v1
#   cloud    a hosted API. Set STT_CLOUD_API_KEY. Costs money and sends your
#            voice off-box — deliberately not the default.
#
# Under whisper/cloud the phone still sends its own transcript alongside the
# audio, and it is used if the upload or the model fails. Losing accuracy beats
# losing the turn and making you repeat yourself.
# Verified working configuration for a self-hosted setup, if you want one:
#   docker run -d -p 8791:8000 ghcr.io/speaches-ai/speaches:latest-cpu
#   curl -X POST http://localhost:8791/v1/models/Systran/faster-whisper-small
#   STT_PROVIDER=whisper
#   STT_WHISPER_URL=http://<host>:8791/v1
#   STT_MODEL=Systran/faster-whisper-small
# The model is not bundled - the second command downloads it once, and until it
# has run every transcription fails with "not installed locally".
STT_PROVIDER=device
STT_WHISPER_URL=
STT_CLOUD_URL=https://api.openai.com/v1
STT_CLOUD_API_KEY=
STT_MODEL=whisper-1
# Naming the language is faster and less error-prone than letting it detect.
STT_LANGUAGE=
STT_TIMEOUT_MS=30000
