node_modules/

# Anchored with a leading slash on purpose. A bare `data/` also matches
# android/app/src/main/java/.../data/, which silently kept the app's entire
# data layer out of the repo until CI failed to compile.
/data/
.env
.mcp.json
*.log

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/release/
*.keystore
*.jks

# A copy of the live database. Contains device push tokens and pairing state,
# so this is a credential leak, not just noise.
/data.bak/

# Host-side mount for the Firebase service-account key (see docker-compose.yml).
/secrets/

# Build outputs. Releases carry the APK; the repo should not.
*.apk
*.aab

# Local Codex config. Carries a live agent bearer token.
/.codex/
