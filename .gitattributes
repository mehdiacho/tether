# Line endings are pinned rather than left to each machine's git config.
#
# The failure this prevents is worth naming: a CRLF `gradlew` or `.sh` checked
# out on the Linux CI runner fails with "bad interpreter: No such file or
# directory", which reads like a missing file and sends you looking in entirely
# the wrong place.
* text=auto eol=lf

# Windows batch files are the one thing that genuinely wants CRLF.
*.bat text eol=crlf

*.jar      binary
*.apk      binary
*.aab      binary
*.jks      binary
*.keystore binary
*.png      binary
*.mp3      binary
